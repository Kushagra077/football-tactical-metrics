data/raw/
data/cache/*
!data/cache/.gitkeep

# Test / tooling caches
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Generated report artifacts (the JSON files ARE committed; figures are not)
reports/figures/*.png
